# Optional automatic CLI pairing. Leave empty to pair from the website.
PHONE_NUMBER=

# Public URL shown by the .pair command in WhatsApp.
PAIRING_SITE_URL=https://your-domain.example

# Web server settings
PORT=3000
HOST=0.0.0.0

# Logging: silent, fatal, error, warn, info, debug, or trace
BAILEYS_LOG_LEVEL=warn
